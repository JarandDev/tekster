---
interface Props {
    title?: string;
    description?: string;
    noindex?: boolean;
    article?: boolean;
    textsIndex?: boolean;
    textsSection?: boolean;
}

const {
    title = 'Tekster – J4D',
    description = 'Tekster og historier om teknologi, sykkelturer og det som ellers dukker opp.',
    noindex = false,
    article = false,
    textsIndex = false,
    textsSection = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html data-color-scheme="light" data-size="md" lang="nb">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <meta content="light dark" name="color-scheme"/>
    <meta content={description} name="description"/>
    <script is:inline>document.documentElement.classList.add('session-checking'); window.j4dSessionFallback = setTimeout(() => document.documentElement.classList.remove('session-checking'), 8000);</script>
    {noindex &&
            <meta content="noindex, nofollow" name="robots"/>}
    <meta content={title} property="og:title"/>
    <meta content={description} property="og:description"/>
    <meta content={canonical.href} property="og:url"/>
    <meta content={article ? 'article' : 'website'} property="og:type"/>
    <meta content="nb_NO" property="og:locale"/>
    <title>{title}</title>
    <link href={canonical} rel="canonical"/>
    <link href="https://cdn.jsdelivr.net/npm/@digdir/designsystemet-css@1.23.0/dist/src/index.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/@digdir/designsystemet-css@1.23.0/dist/theme/designsystemet.css" rel="stylesheet"/>
    <link href="/assets/css/style.css" rel="stylesheet"/>
    <link href="/assets/css/writings.css" rel="stylesheet"/>
    <link href="https://j4d.dev/shared/header/header.css" rel="stylesheet"/>
    <link href="https://j4d.dev/shared/footer/footer.css" rel="stylesheet"/>
    <script is:inline src="https://j4d.dev/shared/theme.js"></script>
    <script is:inline defer src="https://j4d.dev/shared/session.js"></script>
    <script is:inline defer src="https://j4d.dev/shared/header/header.js"></script>
    <script is:inline defer src="https://j4d.dev/shared/footer/footer.js"></script>
</head>
<body>
<a class="skip-link ds-link" href="#main">Hopp til innhold</a>
<j4d-header active-page={textsIndex ? 'tekster' : (article || textsSection ? 'tekster-section' : '')}>
    <a href="https://j4d.dev/">J4D</a>
</j4d-header>
<main class="container" id="main" tabindex="-1">
    <slot/>
</main>
<j4d-footer domain="txt.j4d.dev" built-with='[{"name":"Astro","url":"https://astro.build/"},{"name":"Designsystemet","url":"https://designsystemet.no/"}]' repository='{"name":"JarandDev/tekster","url":"https://github.com/JarandDev/tekster"}'></j4d-footer>
</body>
</html>
